# CIRO — Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env.

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:ciro_pass@localhost:5432/ciro

# External APIs
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App
ENVIRONMENT=development

# Frontend (web-dashboard/.env.local)
# REACT_APP_BACKEND_URL=http://localhost:8000
# REACT_APP_WS_URL=ws://localhost:8000
